# ---------------------------------------------------------------
# Copy to .env.local for local development. On Vercel, add these
# under Project → Settings → Environment Variables.
# Never commit real secrets. NEXT_PUBLIC_* values are visible to browsers by design.
# ---------------------------------------------------------------

# Supabase (Project Settings → API). The publishable key is safe to expose:
# row-level security limits the public to reading published content and submitting forms.
NEXT_PUBLIC_SUPABASE_URL=https://airfuywxmjhkhonxpoeq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The ONLY email allowed into /admin (comma-separate to allow more than one)
ADMIN_EMAIL=you@example.com

# Optional — your custom domain once you have one (otherwise the Vercel URL is used)
# NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# Optional — social / integrations
# NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@yourchannel
# GITHUB_USERNAME=rupeshkarn7-art
# GITHUB_TOKEN=            # server-only, read-only token to raise GitHub API limits

# Optional — email me when a form is submitted (https://resend.com, free tier)
# RESEND_API_KEY=
# RESEND_FROM=Website <hello@yourdomain.com>

# Optional — analytics (nothing loads unless set)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
